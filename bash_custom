export PATH="/usr/local/bin:$HOME/.local/bin:$PATH"

# VI mode!
set -o vi

#OSX specific
if [[ "`uname`" == "Darwin" ]]
  then
    alias ls='ls -G'
    alias python="python3"
    alias pip="pip3"
    alias vi="nvim"
    alias vig="nvim '+Git'"
    alias vin="nvim '+NERDTreeToggle'"
